# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public URL of the deployed site (used in share links, QR codes and calendar files)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, server only (see README). Ask works without any key: it is a free search of the site.
# GROQ_API_KEY=            transcripts, and summaries too
# ANTHROPIC_API_KEY=       summaries; with ASK_PROVIDER=claude, written answers in Ask (paid)
# ASK_PROVIDER=claude
# SUPABASE_SERVICE_ROLE_KEY=   with migration 0014_security.sql: written answers for people outside the team
